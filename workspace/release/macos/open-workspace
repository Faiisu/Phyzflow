#!/bin/sh
set -eu
resources="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)"
cd /
unset VIRTUAL_ENV CONDA_PREFIX PYTHONPATH PYTHONHOME UV_PROJECT_ENVIRONMENT
PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"
export PATH
if ! command -v uv >/dev/null; then
  printf '%s\n' 'Install uv from https://docs.astral.sh/uv/getting-started/installation/ and reopen Workspace.' >&2
  exit 1
fi
exec uv run --no-config --no-project --python 3.12 python "$resources/launch.py" "$@"
